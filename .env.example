# ---- LLM ----
# เก็บชื่อ model / base URL ไว้ที่นี่เพื่อสลับ provider ได้โดยไม่แก้โค้ด
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0

# ---- Embedding ----
# ตัวเลือก: BAAI/bge-m3 (คุณภาพสูงสุด ~2.2GB) | intfloat/multilingual-e5-base (~1.1GB)
EMBEDDING_MODEL=BAAI/bge-m3


# ---- Retrieval ----
RETRIEVAL_TOP_K=5
CHROMA_COLLECTION=techcorp_kb

# ---- Mock API ----
MOCK_API_BASE_URL=http://localhost:8080/api
MOCK_API_TOKEN=techcorp-mock-token-2025

# ---- Agent ----
MEMORY_MAX_TURNS=5
AGENT_MAX_ITERATIONS=5
LOG_LEVEL=INFO
